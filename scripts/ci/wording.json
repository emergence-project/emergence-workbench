    { "avoid": "함께 쓴 사람", "use": "공저자", "max": 1 },
    { "avoid": "왜", "use": "의의", "whole": true, "max": 2 },
    { "avoid": "언제 끝나나", "use": "종료 조건", "max": 2 },
