{
  "name": "emergence-workbench",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.13.0+sha512.1e55719bf26e809dce5c5084fdebaa64efb3da9038ae5d68a9f8a68311f1a45841c8c3b76a37298c3b66f6bcc80409a9b7f33c78a7168a3e90fb65a5d8235ae4",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter \"./apps/*\" dev",
    "dev:en": "RW_SAMPLE_LANG=en pnpm dev",
    "test": "node scripts/ci/test-all.mjs",
    "agent:status": "node scripts/agent-status.mjs",
    "agent:check": "node scripts/agent-check.mjs",
    "agent:feedback": "node scripts/agent-feedback.mjs",
    "agent:records": "node scripts/agent-records.mjs",
    "agent:answer": "node scripts/agent-answer.mjs",
    "agent:start": "node scripts/agent-start.mjs",
    "agent:integrate": "node scripts/agent-integrate.mjs",
    "library:memos": "node scripts/library-memos.mjs",
    "agent:check-tasks": "node scripts/agent-check-tasks.mjs",
    "mcp": "node scripts/mcp.mjs",
    "design:check": "node scripts/ci/check-design.mjs",
    "wording:check": "node scripts/ci/check-wording.mjs",
    "type-check": "pnpm -r run type-check && pnpm --filter @rw/server exec tsc -p ../../scripts/tsconfig.json",
    "start": "pnpm build && zsh scripts/serve.sh",
    "build": "pnpm --filter @rw/web build",
    "mac:install": "zsh scripts/install.sh",
    "agents:register": "zsh scripts/register-agents.sh",
    "service:install": "zsh scripts/service.sh install",
    "service:restart": "zsh scripts/service.sh restart",
    "service:status": "zsh scripts/service.sh status",
    "service:logs": "zsh scripts/service.sh logs",
    "service:uninstall": "zsh scripts/service.sh uninstall",
    "test:autosave-close": "node scripts/shots/autosave-close.mjs",
    "test:scripts": "node --test scripts/remote/*.test.mjs",
    "shots": "node scripts/shots/shots.mjs",
    "safety:check": "node scripts/safety/check-repo.mjs"
  },
  "devDependencies": {
    "playwright-core": "1.63.0"
  }
}
