% -----------------------------------------------------------------------------
% Standard Beamer blocks are the single general-purpose titled-box API. Their
% geometry preserves the established KFB titled-box design while block,
% alertblock, and exampleblock remain native Beamer environments.
% -----------------------------------------------------------------------------
\tcbset{
  kfb standard block/.style={
    enhanced,
    boxrule=0.55pt,
    arc=1.5mm,
    left=2.8mm,
    right=2.8mm,
    top=2.2mm,
    bottom=2.2mm,
    lefttitle=2.8mm,
    righttitle=2.8mm,
    toptitle=1.7mm,
    bottomtitle=1.2mm,
    boxsep=0mm,
    before upper={\raggedright},
    before skip=\kfb@boxskip,
    after skip=\kfb@boxskip
  }
}

\newcommand{\kfb@beginstandardblock}[3]{%
  \begingroup
  \usebeamercolor*{#1}%
  \colorlet{kfb@blocktitlefg}{fg}%
  \colorlet{kfb@blocktitlebg}{bg}%
  \usebeamercolor*{#2}%
  \colorlet{kfb@blockbodyfg}{fg}%
  \colorlet{kfb@blockbodybg}{bg}%
  \begin{tcolorbox}[
    kfb standard block,
    coltitle=kfb@blocktitlefg,
    coltext=kfb@blockbodyfg,
    colback=kfb@blockbodybg,
    colframe=#3,
    colbacktitle=kfb@blocktitlebg,
    fontupper={\usebeamerfont{#2}},
    fonttitle={\usebeamerfont{#1}},
    adjusted title={\insertblocktitle}
  ]%
}
\setbeamertemplate{block begin}{%
  \kfb@beginstandardblock{block title}{block body}{KFBBlockLine}%
}
\setbeamertemplate{block end}{\end{tcolorbox}\endgroup}
\setbeamertemplate{block alerted begin}{%
  \kfb@beginstandardblock{block title alerted}{block body alerted}{KFBWarningLine}%
}
\setbeamertemplate{block alerted end}{\end{tcolorbox}\endgroup}
\setbeamertemplate{block example begin}{%
  \kfb@beginstandardblock{block title example}{block body example}{KFBResultLine}%
}
\setbeamertemplate{block example end}{\end{tcolorbox}\endgroup}

\newtcolorbox{band}[2][]{
  enhanced,
  colback=KFBNavyDark,
  colframe=KFBNavyDark,
  coltext=white,
  fontupper=\kfb@bodyfont,
  boxrule=0pt,
  arc=1.5mm,
  left=3.4mm,
  right=3.4mm,
  top=2.4mm,
  bottom=2.4mm,
  boxsep=0mm,
  before upper={\raggedright{\kfb@boxtitlefont #2\par}},
  before skip=\kfb@boxskip,
  after skip=\kfb@boxskip,
  #1
}

% -----------------------------------------------------------------------------
% Semantic callouts and standard theorem compatibility.
% -----------------------------------------------------------------------------
\tcbset{
  kfb semantic base/.style={
    enhanced,
    boxrule=0.42pt,
    arc=1.2mm,
    left=2.8mm,
    right=2.8mm,
    top=1.7mm,
    bottom=1.7mm,
    boxsep=0mm,
    before upper={\raggedright},
    before skip=\kfb@boxskip,
    after skip=\kfb@boxskip
  },
  kfb theorem base/.style={
    kfb semantic base,
    coltext=KFBBody,
    fontupper=\kfb@bodyfont,
    fonttitle=\normalfont\kfb@boxtitlefont,
    coltitle=white,
    lefttitle=2.8mm,
    righttitle=2.8mm,
    toptitle=1.4mm,
    bottomtitle=1.0mm,
    titlerule=0pt
  }
}

\newcommand{\mdselectcalloutpalette}[1]{%
  \def\mdcalloutcolor{KFBNote}%
  \def\mdcalloutsurface{KFBNoteSurface}%
  \def\mdcalloutline{KFBNoteLine}%
  \ifboolexpr{test {\ifstrequal{#1}{warning}} or test {\ifstrequal{#1}{danger}}}{%
    \def\mdcalloutcolor{KFBWarning}%
    \def\mdcalloutsurface{KFBWarningSurface}%
    \def\mdcalloutline{KFBWarningLine}%
  }{}%
  \ifboolexpr{test {\ifstrequal{#1}{result}} or test {\ifstrequal{#1}{success}}}{%
    \def\mdcalloutcolor{KFBResult}%
    \def\mdcalloutsurface{KFBResultSurface}%
    \def\mdcalloutline{KFBResultLine}%
  }{}%
  \ifboolexpr{
    test {\ifstrequal{#1}{note}} or
    test {\ifstrequal{#1}{warning}} or
    test {\ifstrequal{#1}{danger}} or
    test {\ifstrequal{#1}{result}} or
    test {\ifstrequal{#1}{success}}
  }{}{%
    \PackageWarning{knowledge-factory-beamer}
      {Unknown mdcallout type `#1'; using `note'}%
  }%
}

\NewDocumentEnvironment{mdcallout}{O{note} O{} m}{%
  \mdselectcalloutpalette{#1}%
  \ifstrempty{#2}{%
    \tcbset{kfb current callout height/.style={}}%
  }{%
    \tcbset{kfb current callout height/.style={equal height group={#2}}}%
  }%
  \begin{tcolorbox}[
    kfb semantic base,
    colback=\mdcalloutsurface,
    colframe=\mdcalloutline,
    colbacktitle=\mdcalloutcolor,
    coltitle=white,
    fontupper=\kfb@bodyfont,
    fonttitle=\kfb@boxtitlefont,
    adjusted title={#3},
    lefttitle=2.8mm,
    righttitle=2.8mm,
    toptitle=1.4mm,
    bottomtitle=1.0mm,
    titlerule=0pt,
    kfb current callout height
  ]%
}{%
  \end{tcolorbox}%
}

\newcommand{\kfb@selecttheorempalette}{%
  \def\kfb@theoremback{KFBTheoremSurface}%
  \def\kfb@theoremline{KFBTheoremLine}%
  \def\kfb@theoremtitle{KFBTheorem}%
  \let\kfb@currenttheoremname\inserttheoremname
  \def\kfb@lemmaname{\translate{Lemma}}%
  \def\kfb@corollaryname{\translate{Corollary}}%
  \def\kfb@definitionname{\translate{Definition}}%
  \def\kfb@definitionsname{\translate{Definitions}}%
  \def\kfb@examplename{\translate{Example}}%
  \def\kfb@examplesname{\translate{Examples}}%
  \ifdefstrequal{\kfb@currenttheoremname}{\kfb@lemmaname}{%
    \def\kfb@theoremback{KFBLemmaSurface}%
    \def\kfb@theoremline{KFBLemmaLine}%
    \def\kfb@theoremtitle{KFBLemma}%
  }{}%
  \ifdefstrequal{\kfb@currenttheoremname}{\kfb@corollaryname}{%
    \def\kfb@theoremback{KFBCorollarySurface}%
    \def\kfb@theoremline{KFBCorollaryLine}%
    \def\kfb@theoremtitle{KFBCorollary}%
  }{}%
  \ifdefstrequal{\kfb@currenttheoremname}{\kfb@definitionname}{%
    \def\kfb@theoremback{KFBDefinitionSurface}%
    \def\kfb@theoremline{KFBDefinitionLine}%
    \def\kfb@theoremtitle{KFBDefinition}%
  }{}%
  \ifdefstrequal{\kfb@currenttheoremname}{\kfb@definitionsname}{%
    \def\kfb@theoremback{KFBDefinitionSurface}%
    \def\kfb@theoremline{KFBDefinitionLine}%
    \def\kfb@theoremtitle{KFBDefinition}%
  }{}%
  \ifdefstrequal{\kfb@currenttheoremname}{\kfb@examplename}{%
    \def\kfb@theoremback{KFBExampleSurface}%
    \def\kfb@theoremline{KFBExampleLine}%
    \def\kfb@theoremtitle{KFBExample}%
  }{}%
  \ifdefstrequal{\kfb@currenttheoremname}{\kfb@examplesname}{%
    \def\kfb@theoremback{KFBExampleSurface}%
    \def\kfb@theoremline{KFBExampleLine}%
    \def\kfb@theoremtitle{KFBExample}%
  }{}%
}

% This environment mirrors Beamer's overlay-aware block contract. Beamer appends
% the theorem overlay specification after the begin template, so the template
% must end in an environment that consumes <...> rather than wrapping the
% theorem externally with tcolorboxenvironment.
\newenvironment<>{kfbtheoremblock}[1]{%
  \begin{actionenv}#2%
  \kfb@selecttheorempalette
  \begin{tcolorbox}[
    kfb theorem base,
    colback=\kfb@theoremback,
    colframe=\kfb@theoremline,
    colbacktitle=\kfb@theoremtitle,
    adjusted title={#1}
  ]%
}{%
  \end{tcolorbox}%
  \end{actionenv}%
}

\setbeamertemplate{theorem begin}{%
  \begin{kfbtheoremblock}{%
    \inserttheoremname\inserttheoremnumber
    \ifx\inserttheoremaddition\@empty\else\ (\inserttheoremaddition)\fi
  }%
}
\setbeamertemplate{theorem end}{\end{kfbtheoremblock}}

