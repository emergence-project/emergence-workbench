% -----------------------------------------------------------------------------
% Beamer chrome.
% -----------------------------------------------------------------------------
\setbeamercolor{normal text}{fg=KFBBody,bg=white}
\setbeamercolor{frametitle}{fg=white,bg=KFBNavy}
\setbeamercolor{framesubtitle}{fg=white!78,bg=KFBNavy}
\setbeamercolor{footline}{fg=white,bg=KFBNavy}
% Typography stays at the regular face unless the document author explicitly
% requests emphasis with \textbf or a local bold declaration.
\setbeamerfont{title}{series=\mdseries}
\setbeamerfont{subtitle}{series=\mdseries}
\setbeamerfont{frametitle}{size=\kfb@frametitlefont,series=\mdseries}
\setbeamerfont{framesubtitle}{size=\small,series=\mdseries}
\setbeamerfont{block body}{size=\kfb@bodyfont}
\setbeamerfont{block body alerted}{parent=block body}
\setbeamerfont{block body example}{parent=block body}
\setbeamerfont{block title}{size=\kfb@boxtitlefont,series=\mdseries}
\setbeamerfont{block title alerted}{parent=block title,series=\mdseries}
\setbeamerfont{block title example}{parent=block title,series=\mdseries}
\setbeamercolor{block title}{fg=white,bg=KFBNavy}
\setbeamercolor{block body}{fg=KFBBody,bg=white}
\setbeamercolor{block title alerted}{fg=white,bg=KFBWarning}
\setbeamercolor{block body alerted}{fg=KFBBody,bg=KFBWarningSurface}
\setbeamercolor{block title example}{fg=white,bg=KFBResult}
\setbeamercolor{block body example}{fg=KFBBody,bg=KFBResultSurface}
\setbeamerfont{section in toc}{size=\kfb@sectionfont,series=\mdseries}
\setbeamercolor{section in toc}{fg=KFBInk}
\setbeamerfont{subsection in toc}{size=\kfb@bodyfont,series=\mdseries}
\setbeamercolor{subsection in toc}{fg=KFBBody}
\setbeamertemplate{section in toc}[sections numbered]
\defbeamertemplate{subsection in toc}{knowledge-factory section page}{%
  \leavevmode
  \makebox[2.2em][l]{%
    \usebeamercolor[fg]{section page subsection number}%
    \inserttocsubsectionnumber%
  }%
  \inserttocsubsection\par\vspace{0.16em}%
}
\setbeamerfont{section page subsection}{size=\kfb@bodyfont,series=\mdseries}
\setbeamercolor{section page subsection}{fg=KFBInk}
\setbeamercolor{section page subsection number}{fg=KFBGoldText}
\setbeamersize{text margin left=0.54cm,text margin right=0.54cm}
\setbeamertemplate{navigation symbols}{}
\setbeamertemplate{itemize item}{\color{KFBNavy}\raise0.15ex\hbox{\scriptsize$\bullet$}}
\setbeamertemplate{itemize subitem}{\color{KFBGoldDeep}\raise0.18ex\hbox{\tiny$\bullet$}}
\setlength{\leftmargini}{1.10em}
\setlength{\leftmarginii}{1.05em}

% Keep standard LaTeX/Beamer citation commands while replacing Beamer's large
% document icon and bright default bibliography colors with a compact inline
% entry and the theme's restrained academic palette.
\setbeamertemplate{bibliography item}[text]
\setbeamertemplate{bibliography entry title}{\hspace{0.28em}}
\setbeamertemplate{bibliography entry location}{\hspace{0.28em}}
\setbeamertemplate{bibliography entry note}{\hspace{0.28em}}
\setbeamercolor{bibliography item}{fg=KFBNavy}
\setbeamercolor{bibliography entry author}{fg=KFBNavy}
\setbeamercolor{bibliography entry title}{fg=KFBInk}
\setbeamercolor{bibliography entry location}{fg=KFBMuted}
\setbeamercolor{bibliography entry note}{fg=KFBMuted}
\setbeamerfont{bibliography item}{size=\scriptsize,series=\mdseries}
\setbeamerfont{bibliography entry author}{size=\scriptsize,series=\mdseries}
\setbeamerfont{bibliography entry title}{size=\scriptsize,series=\mdseries,shape=\upshape}
\setbeamerfont{bibliography entry location}{size=\scriptsize,series=\mdseries}
\setbeamerfont{bibliography entry note}{size=\scriptsize,series=\mdseries,shape=\upshape}
\newlength{\kfb@bibliographyitemsep}
\setlength{\kfb@bibliographyitemsep}{-0.11em}
\NewDocumentCommand{\KFBSetBibliographyItemSep}{m}{%
  \setlength{\kfb@bibliographyitemsep}{#1}%
}
\apptocmd{\thebibliography}{%
  \setlength{\itemsep}{\kfb@bibliographyitemsep}%
  \setlength{\parsep}{0pt}%
  \setlength{\parskip}{0pt}%
}{}{%
  \PackageWarningNoLine{knowledge-factory-beamer}
    {KFB-BIB-PATCH-FAILED: Could not apply compact bibliography spacing}%
}

\newcommand{\kfbaccent}{KFBGold}
\NewDocumentCommand{\KFBSetAccent}{m}{\gdef\kfbaccent{#1}}
\newbox\kfb@frametitlebox
\newbox\kfb@frametitleonlybox
\newdimen\kfb@frametitletopskip
\newdimen\kfb@frametitlebottomskip
\newdimen\kfb@frameaccenttopskip
\newdimen\kfb@frametitleleftskip
\newdimen\kfb@frameaccentwidth
\newdimen\kfb@frametitlegap
\newdimen\kfb@frametitlerightskip
\newdimen\kfb@frametitletextwidth
\kfb@frametitletopskip=1.9mm
\kfb@frametitlebottomskip=0.3mm
\kfb@frameaccenttopskip=\dimexpr
  \kfb@frametitletopskip+\kfb@frametitlebottomskip\relax
\divide\kfb@frameaccenttopskip by 2
\kfb@frametitleleftskip=1.8mm
\kfb@frameaccentwidth=1.2mm
\kfb@frametitlegap=1.0mm
\kfb@frametitlerightskip=4.4mm
\kfb@frametitletextwidth=\dimexpr
  \paperwidth-\kfb@frametitleleftskip-\kfb@frameaccentwidth
  -\kfb@frametitlegap-\kfb@frametitlerightskip\relax

\setbeamertemplate{frametitle}{%
  \nointerlineskip
  % Measure the title separately and keep the accent at the same vertical
  % position whether or not a subtitle deepens the navy header.
  \setbox\kfb@frametitleonlybox=\vbox{%
    \hsize=\kfb@frametitletextwidth
    \parindent=0pt
    {\usebeamerfont{frametitle}\usebeamercolor[fg]{frametitle}\raggedright
      \strut\insertframetitle\strut\par}%
  }%
  \setbox\kfb@frametitlebox=\vbox{%
    \hsize=\kfb@frametitletextwidth
    \parindent=0pt
    \vskip\kfb@frametitletopskip
    \copy\kfb@frametitleonlybox
    \ifx\insertframesubtitle\@empty
      \vskip\kfb@frametitlebottomskip
    \else
      \vskip0.45mm
      {\usebeamerfont{framesubtitle}\usebeamercolor[fg]{framesubtitle}\raggedright
        \strut\insertframesubtitle\strut\par}%
      \vskip0.7mm
    \fi
  }%
  \begin{beamercolorbox}[wd=\paperwidth,sep=0pt]{frametitle}%
    \hbox to \paperwidth{%
      \hskip\kfb@frametitleleftskip
      \vbox to \dimexpr\ht\kfb@frametitlebox+\dp\kfb@frametitlebox\relax{%
        \vskip\kfb@frameaccenttopskip
        \hbox{{\color{\kfbaccent}\rule{\kfb@frameaccentwidth}{%
          \dimexpr\ht\kfb@frametitleonlybox+\dp\kfb@frametitleonlybox\relax}}}%
        \vfil
      }%
      \hskip\kfb@frametitlegap
      \box\kfb@frametitlebox
      \hfil
      \hskip\kfb@frametitlerightskip
    }%
  \end{beamercolorbox}%
}

% \secname is plain text; \insertsectionhead can inherit hyperlink colors when
% a user enables colorlinks through hyperref.
\providecommand{\lastsection}{}
\newcommand{\kfbfooterlabel}{\lastsection}
\newcommand{\kfbfootercenter}{\insertshortinstitute}
\NewDocumentCommand{\KFBSetFooterLabel}{m}{\gdef\kfbfooterlabel{#1}}
\NewDocumentCommand{\KFBSetFooterCenter}{m}{\gdef\kfbfootercenter{#1}}

\setbeamertemplate{footline}{%
  \leavevmode
  \hbox{%
    \begin{beamercolorbox}[wd=.34\paperwidth,ht=0.30cm,dp=0.09cm,leftskip=0.54cm]{footline}%
      \fontsize{6.9}{7.7}\selectfont\mdseries\kfbfooterlabel
    \end{beamercolorbox}%
    \begin{beamercolorbox}[wd=.32\paperwidth,ht=0.30cm,dp=0.09cm,center]{footline}%
      \fontsize{6.9}{7.7}\selectfont\mdseries\kfbfootercenter
    \end{beamercolorbox}%
    \begin{beamercolorbox}[wd=.34\paperwidth,ht=0.30cm,dp=0.09cm,rightskip=0.54cm plus1fil]{footline}%
      \hfill\fontsize{6.9}{7.7}\selectfont\mdseries
      \insertframenumber\ / \inserttotalframenumber
    \end{beamercolorbox}%
  }%
}

% -----------------------------------------------------------------------------
% Standard metadata drives the custom title page.
% -----------------------------------------------------------------------------
\newcommand{\kfbcoverlabel}{PRESENTATION}
\NewDocumentCommand{\KFBSetCoverLabel}{m}{\gdef\kfbcoverlabel{#1}}

\setbeamertemplate{title page}{%
  \begin{tikzpicture}[remember picture,overlay]
    \shade[left color=KFBNavyDark,right color=KFBCoverRight]
      (current page.south west) rectangle (current page.north east);

    \node[anchor=north west,inner sep=0pt,text width=.84\paperwidth,align=left]
      at ($(current page.south west)+(0.80cm,6.06cm)$) {%
        \raggedright\hyphenpenalty=10000\exhyphenpenalty=10000
        {\fontsize{27}{31}\selectfont\mdseries\color{white}\inserttitle\par}%
        \ifdefempty{\insertsubtitle}{}{%
          \vspace{0.25cm}%
          {\fontsize{13.0}{15.5}\selectfont\mdseries\color{KFBOrange}\insertsubtitle\par}%
        }%
        \expandafter\ifblank\expandafter{\beamer@andstripped}{}{%
          \vspace{0.32cm}%
          {\fontsize{9.8}{11.4}\selectfont\color{white}\insertauthor\par}%
        }%
      };
    \node[anchor=south west,text=white]
      at ($(current page.south west)+(0.30cm,0.30cm)$) {%
        \fontsize{7.1}{8.1}\selectfont\mdseries\kfbcoverlabel%
      };
    \node[anchor=south east,text=white,align=right]
      at ($(current page.south east)+(-0.30cm,0.30cm)$) {%
        \fontsize{7.0}{8.2}\selectfont
        \ifdefempty{\insertinstitute}{%
          \insertdate
        }{%
          \insertinstitute
          \ifdefempty{\insertdate}{}{\enspace\textperiodcentered\enspace\insertdate}%
        }%
      };
  \end{tikzpicture}%
}

% Keep Beamer's own \titlepage and \maketitle commands unchanged. Authors who
% want the branded unnumbered cover declare the frame options explicitly:
% \begin{frame}[plain,noframenumbering]\titlepage\end{frame}.

% -----------------------------------------------------------------------------
% Standard Beamer section page. Documents opt in with \sectionpage, commonly
% through \AtBeginSection in main.tex. Both named variants use a fixed 2:3:2
% vertical ratio. The default keeps the lower band empty; the optional variant
% renders the current section's subsections there through Beamer's native TOC.
% -----------------------------------------------------------------------------
\newcommand{\kfb@sectionpageart}{%
  \fill[KFBNoteSurface]
    (current page.south west) rectangle (current page.north east);
  \fill[KFBNavy]
    ($(current page.south west)!2/7!(current page.north west)$) rectangle
    ($(current page.south east)!5/7!(current page.north east)$);

  \node[anchor=center,text=white]
    at ($(current page.west)!1/12!(current page.east)$) {%
      \fontsize{30}{32}\selectfont\mdseries\insertsectionnumber%
    };
  \node[anchor=center,inner sep=0pt]
    at ($(current page.west)!1/6!(current page.east)$) {%
      \color{KFBGold}\rule{1.2mm}{\dimexpr\paperheight/5\relax}%
    };
  % Match the title's left and right clear space: both are 1/12 of the page.
  \node[anchor=west,inner sep=0pt,
    text width=\dimexpr2\paperwidth/3\relax,align=left,text=white]
    at ($(current page.west)!1/4!(current page.east)$) {%
      \raggedright\hyphenpenalty=10000\exhyphenpenalty=10000
      \fontsize{21}{25}\selectfont\mdseries\secname\par%
    };
}

\defbeamertemplate{section page}{knowledge-factory minimal}{%
  \begin{tikzpicture}[remember picture,overlay]
    \kfb@sectionpageart
  \end{tikzpicture}%
}

\defbeamertemplate{section page}{knowledge-factory with subsections}{%
  \begingroup
    \setbeamerfont*{subsection in toc}{parent=section page subsection}
    \setbeamercolor*{subsection in toc}{parent=section page subsection}
    \setbeamertemplate{subsection in toc}[knowledge-factory section page]
    \begin{tikzpicture}[remember picture,overlay]
      \kfb@sectionpageart
      \node[anchor=center,inner sep=0pt,
        text width=\dimexpr\paperwidth/2\relax,align=left,text=KFBInk]
        at ($(current page.south)+(0,0.142857\paperheight)$) {%
          \begin{minipage}{\dimexpr\paperwidth/2\relax}
            \raggedright
            \usebeamerfont{subsection in toc}%
            \tableofcontents[
              currentsection,
              sectionstyle=hide,
              subsectionstyle=show/show/hide
            ]
          \end{minipage}%
        };
    \end{tikzpicture}%
  \endgroup
}
\setbeamertemplate{section page}[knowledge-factory minimal]

% -----------------------------------------------------------------------------
% Public content roles. Names describe what the author writes rather than the
% package brand or an implementation detail.
% -----------------------------------------------------------------------------
\NewDocumentCommand{\contentsubheading}{m}{%
  {\kfb@sectionfont\color{KFBOrangeDeep}#1\par}%
}
\NewDocumentCommand{\supportingtext}{m}{%
