\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{knowledge-factory-beamer}[2026/08/18 v0.1.1 Knowledge Factory standard-Beamer-first academic theme]
\makeatletter

% -----------------------------------------------------------------------------
% Package mode: talk is the readable projection default; note is denser.
% -----------------------------------------------------------------------------
\newif\ifkfb@note
\kfb@notefalse
\DeclareOption{talk}{\kfb@notefalse}
\DeclareOption{note}{\kfb@notetrue}
\DeclareOption*{\PackageWarning{knowledge-factory-beamer}{Unknown option `\CurrentOption'}}
\ProcessOptions\relax

% The presentation source owns compiler, language, font, and math choices. Fail
% clearly when it omits one of those author-selected dependencies.
\newcommand{\kfb@requireloaded}[1]{%
  \@ifpackageloaded{#1}{}{%
    \PackageError{knowledge-factory-beamer}
      {Required package `#1' is not loaded}
      {Load `#1' in main.tex before knowledge-factory-beamer.}%
  }%
}
\kfb@requireloaded{fontspec}
\kfb@requireloaded{kotex}
\kfb@requireloaded{unicode-math}

% The theme owns the packages and libraries required only by its visual
% implementation. Documents still own content-specific TikZ options/libraries.
\RequirePackage{etoolbox}
\RequirePackage{tikz}
\RequirePackage{tcolorbox}
\usetikzlibrary{calc}
\tcbuselibrary{skins}

% -----------------------------------------------------------------------------
% Portable font selection. Users may redefine the three family names before
% loading the package. No machine-specific path is required.
% -----------------------------------------------------------------------------
\providecommand{\KFBLatinFont}{Noto Sans}
\providecommand{\KFBHangulFont}{Noto Sans CJK KR}
\providecommand{\KFBMathFont}{STIX Two Math}
\providecommand{\KFBFontPath}{}
\def\kfb@macuserfontpath{\string~/Library/Fonts/}

\defaultfontfeatures{Ligatures=TeX}

\newif\ifkfb@latinfontset
\newif\ifkfb@hangulfontset
\newif\ifkfb@latinbundlecomplete
\newif\ifkfb@hangulbundlecomplete
\kfb@latinfontsetfalse
\kfb@hangulfontsetfalse

\newcommand{\kfb@checklatinbundleatpath}[1]{%
  \kfb@latinbundlecompletetrue
  \IfFileExists{#1NotoSans-Regular.ttf}{}{\kfb@latinbundlecompletefalse}%
  \IfFileExists{#1NotoSans-Bold.ttf}{}{\kfb@latinbundlecompletefalse}%
  \IfFileExists{#1NotoSans-Italic.ttf}{}{\kfb@latinbundlecompletefalse}%
  \IfFileExists{#1NotoSans-BoldItalic.ttf}{}{\kfb@latinbundlecompletefalse}%
}

\newcommand{\kfb@checkhangulbundleatpath}[1]{%
  \kfb@hangulbundlecompletetrue
  \IfFileExists{#1NotoSansCJKkr-Regular.otf}{}{\kfb@hangulbundlecompletefalse}%
  \IfFileExists{#1NotoSansCJKkr-Bold.otf}{}{\kfb@hangulbundlecompletefalse}%
}

% Optional relative path for a project-bundled Noto distribution. This keeps
% pixel-identical local/Overleaf output possible without imposing font files on
% the lightweight core package.
\ifdefempty{\KFBFontPath}{}{%
  \kfb@checklatinbundleatpath{\KFBFontPath}%
  \ifkfb@latinbundlecomplete
    \setsansfont[
      Path=\KFBFontPath,
      UprightFont=NotoSans-Regular.ttf,
      BoldFont=NotoSans-Bold.ttf,
      ItalicFont=NotoSans-Italic.ttf,
      BoldItalicFont=NotoSans-BoldItalic.ttf
    ]{NotoSans-Regular.ttf}%
    \kfb@latinfontsettrue
  \else
    \PackageWarningNoLine{knowledge-factory-beamer}
      {Incomplete Latin font bundle in \KFBFontPath; using installed-font fallback}%
  \fi
  \kfb@checkhangulbundleatpath{\KFBFontPath}%
  \ifkfb@hangulbundlecomplete
    \setmainhangulfont[
      Path=\KFBFontPath,
      UprightFont=NotoSansCJKkr-Regular.otf,
      BoldFont=NotoSansCJKkr-Bold.otf,
      ItalicFont=NotoSansCJKkr-Regular.otf,
      BoldItalicFont=NotoSansCJKkr-Bold.otf,
      ItalicFeatures={FakeSlant=0.15},
      BoldItalicFeatures={FakeSlant=0.15}
    ]{NotoSansCJKkr-Regular.otf}%
    \setsanshangulfont[
      Path=\KFBFontPath,
      UprightFont=NotoSansCJKkr-Regular.otf,
      BoldFont=NotoSansCJKkr-Bold.otf,
      ItalicFont=NotoSansCJKkr-Regular.otf,
      BoldItalicFont=NotoSansCJKkr-Bold.otf,
      ItalicFeatures={FakeSlant=0.15},
      BoldItalicFeatures={FakeSlant=0.15}
    ]{NotoSansCJKkr-Regular.otf}%
    \setmonohangulfont[
      Path=\KFBFontPath,
      UprightFont=NotoSansCJKkr-Regular.otf,
      BoldFont=NotoSansCJKkr-Bold.otf,
      ItalicFont=NotoSansCJKkr-Regular.otf,
      BoldItalicFont=NotoSansCJKkr-Bold.otf,
      ItalicFeatures={FakeSlant=0.15},
      BoldItalicFeatures={FakeSlant=0.15}
    ]{NotoSansCJKkr-Regular.otf}%
    \kfb@hangulfontsettrue
  \else
    \PackageWarningNoLine{knowledge-factory-beamer}
      {Incomplete Korean font bundle in \KFBFontPath; using installed-font fallback}%
  \fi
}

% Default Noto families use explicit faces whenever the files are available.
% This avoids platform font metadata resolving \bfseries to SemiBold on one
% build and Bold on another. User-supplied family names retain fontspec's native
% family resolution.
\newcommand{\kfb@setlatinnotofiles}[1]{%
  \setsansfont[
    #1%
    UprightFont=NotoSans-Regular.ttf,
    BoldFont=NotoSans-Bold.ttf,
    ItalicFont=NotoSans-Italic.ttf,
    BoldItalicFont=NotoSans-BoldItalic.ttf
  ]{NotoSans-Regular.ttf}%
}
\newcommand{\kfb@setlatinheros}{%
  \setsansfont[
    UprightFont=texgyreheros-regular.otf,
    BoldFont=texgyreheros-bold.otf,
    ItalicFont=texgyreheros-italic.otf,
    BoldItalicFont=texgyreheros-bolditalic.otf
  ]{texgyreheros-regular.otf}%
  \PackageWarningNoLine{knowledge-factory-beamer}
    {Requested Latin font `\KFBLatinFont' unavailable; using TeX Live TeX Gyre Heros}%
}
\newcommand{\kfb@sethangulnotofiles}[1]{%
  \setmainhangulfont[
    #1%
    UprightFont=NotoSansCJKkr-Regular.otf,
    BoldFont=NotoSansCJKkr-Bold.otf,
    ItalicFont=NotoSansCJKkr-Regular.otf,
    BoldItalicFont=NotoSansCJKkr-Bold.otf,
    ItalicFeatures={FakeSlant=0.15},
    BoldItalicFeatures={FakeSlant=0.15}
  ]{NotoSansCJKkr-Regular.otf}%
  \setsanshangulfont[
    #1%
    UprightFont=NotoSansCJKkr-Regular.otf,
    BoldFont=NotoSansCJKkr-Bold.otf,
    ItalicFont=NotoSansCJKkr-Regular.otf,
    BoldItalicFont=NotoSansCJKkr-Bold.otf,
    ItalicFeatures={FakeSlant=0.15},
    BoldItalicFeatures={FakeSlant=0.15}
  ]{NotoSansCJKkr-Regular.otf}%
  \setmonohangulfont[
    #1%
    UprightFont=NotoSansCJKkr-Regular.otf,
    BoldFont=NotoSansCJKkr-Bold.otf,
    ItalicFont=NotoSansCJKkr-Regular.otf,
    BoldItalicFont=NotoSansCJKkr-Bold.otf,
    ItalicFeatures={FakeSlant=0.15},
    BoldItalicFeatures={FakeSlant=0.15}
  ]{NotoSansCJKkr-Regular.otf}%
}
\newcommand{\kfb@sethangulfamily}[1]{%
  \setmainhangulfont[AutoFakeSlant=0.15]{#1}%
  \setsanshangulfont[AutoFakeSlant=0.15]{#1}%
  \setmonohangulfont[AutoFakeSlant=0.15]{#1}%
}
\newcommand{\kfb@sethangulundotum}{%
  \setmainhangulfont[
    BoldFont=UnDotumBold.ttf,
    ItalicFont=UnDotum.ttf,
    BoldItalicFont=UnDotumBold.ttf,
    ItalicFeatures={FakeSlant=0.15},
    BoldItalicFeatures={FakeSlant=0.15}
  ]{UnDotum.ttf}%
  \setsanshangulfont[
    BoldFont=UnDotumBold.ttf,
    ItalicFont=UnDotum.ttf,
    BoldItalicFont=UnDotumBold.ttf,
    ItalicFeatures={FakeSlant=0.15},
    BoldItalicFeatures={FakeSlant=0.15}
  ]{UnDotum.ttf}%
  \setmonohangulfont[
    BoldFont=UnDotumBold.ttf,
    ItalicFont=UnDotum.ttf,
    BoldItalicFont=UnDotumBold.ttf,
    ItalicFeatures={FakeSlant=0.15},
    BoldItalicFeatures={FakeSlant=0.15}
  ]{UnDotum.ttf}%
  \PackageWarningNoLine{knowledge-factory-beamer}
    {Noto Sans CJK KR unavailable; using TeX Live UnDotum}%
}

\ifkfb@latinfontset\else
  \ifdefstring{\KFBLatinFont}{Noto Sans}{%
    \IfFontExistsTF{NotoSans-Regular.ttf}{%
      \kfb@setlatinnotofiles{}%
      \PackageInfo{knowledge-factory-beamer}
        {Using explicit Noto Sans font files discovered by XeTeX}%
    }{%
      \kfb@checklatinbundleatpath{\kfb@macuserfontpath}%
      \ifkfb@latinbundlecomplete
        \kfb@setlatinnotofiles{Path=\kfb@macuserfontpath,}%
        \PackageInfo{knowledge-factory-beamer}
          {Using explicit Noto Sans faces from the standard macOS user font folder}%
      \else
        \IfFontExistsTF{\KFBLatinFont}{%
          \setsansfont{\KFBLatinFont}%
        }{%
          \kfb@setlatinheros
        }%
      \fi
    }%
  }{%
    \IfFontExistsTF{\KFBLatinFont}{%
      \setsansfont{\KFBLatinFont}%
    }{%
      \kfb@setlatinheros
    }%
  }%
\fi

\ifkfb@hangulfontset\else
  \ifdefstring{\KFBHangulFont}{Noto Sans CJK KR}{%
    \IfFontExistsTF{NotoSansCJKkr-Regular.otf}{%
      \kfb@sethangulnotofiles{}%
      \PackageInfo{knowledge-factory-beamer}
        {Using explicit Noto Sans CJK KR font files discovered by XeTeX}%
    }{%
      \kfb@checkhangulbundleatpath{\kfb@macuserfontpath}%
      \ifkfb@hangulbundlecomplete
        \kfb@sethangulnotofiles{Path=\kfb@macuserfontpath,}%
        \PackageInfo{knowledge-factory-beamer}
          {Using explicit Noto Sans CJK KR faces from the standard macOS user font folder}%
      \else
        \IfFontExistsTF{\KFBHangulFont}{%
          \kfb@sethangulfamily{\KFBHangulFont}%
        }{%
          \kfb@sethangulundotum
        }%
      \fi
    }%
  }{%
    \IfFontExistsTF{\KFBHangulFont}{%
      \kfb@sethangulfamily{\KFBHangulFont}%
    }{%
      \kfb@sethangulundotum
    }%
  }%
\fi

\IfFontExistsTF{\KFBMathFont}{%
  \setmathfont{\KFBMathFont}%
}{%
  \IfFontExistsTF{STIX Two Math}{%
    \setmathfont{STIX Two Math}%
    \PackageWarningNoLine{knowledge-factory-beamer}
      {Requested math font unavailable; using STIX Two Math}%
  }{%
    \setmathfont{latinmodern-math.otf}%
    \PackageWarningNoLine{knowledge-factory-beamer}
      {STIX Two Math unavailable; using Latin Modern Math}%
  }%
}

